{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://exergy-connect.github.io/33audio.com/schema/vocab#",
    "audio33-catalog": {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#",
      "@prefix": true
    },
    "xyang-jsonld": {
      "@id": "https://exergy-connect.github.io/xYang/jsonld#",
      "@prefix": true
    },
    "currency": {
      "@id": "https://schema.org/priceCurrency"
    },
    "unit_price": {
      "@id": "https://schema.org/price"
    },
    "region_note": {
      "@id": "https://schema.org/eligibleRegion"
    },
    "provenance": {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#provenance"
    },
    "source_url": {
      "@id": "https://schema.org/isBasedOn",
      "@type": "@id"
    },
    "seller": {
      "@id": "https://schema.org/seller",
      "@context": {
        "name": {
          "@id": "https://schema.org/name"
        },
        "email": {
          "@id": "https://schema.org/email"
        },
        "locality": {
          "@id": "https://schema.org/addressLocality"
        },
        "region": {
          "@id": "https://schema.org/addressRegion"
        },
        "country": {
          "@id": "https://schema.org/addressCountry"
        },
        "ebay_store": {
          "@id": "https://schema.org/sameAs",
          "@type": "@id"
        },
        "ebay_seller": {
          "@id": "https://schema.org/alternateName"
        }
      }
    },
    "shipping": {
      "@id": "https://schema.org/shippingDetails",
      "@context": {
        "amount": {
          "@id": "https://schema.org/shippingRate"
        },
        "currency": {
          "@id": "https://schema.org/currency"
        },
        "per": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#per"
        },
        "country": {
          "@id": "https://schema.org/shippingDestination"
        },
        "summary": {
          "@id": "https://schema.org/description"
        }
      }
    },
    "series": {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#series",
      "@context": {
        "name": {
          "@id": "https://schema.org/model"
        },
        "family": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#family"
        },
        "product_line": {
          "@id": "https://schema.org/category"
        },
        "film": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#film"
        },
        "power_rating": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#power_rating"
        },
        "voltage_rating": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#voltage_rating"
        },
        "default_tolerance": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#default_tolerance"
        },
        "not_recommended_for_new_designs": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#not_recommended_for_new_designs"
        },
        "datasheet": {
          "@id": "https://schema.org/subjectOf",
          "@type": "@id"
        }
      }
    },
    "parts": {
      "@id": "https://schema.org/itemListElement",
      "@context": {
        "part_number": {
          "@id": "https://schema.org/mpn"
        },
        "manufacturer": {
          "@id": "https://schema.org/manufacturer"
        },
        "series": {
          "@id": "https://schema.org/model"
        },
        "resistance": {
          "@id": "https://schema.org/additionalProperty",
          "@context": {
            "value": {
              "@id": "https://schema.org/value"
            },
            "unit": {
              "@id": "https://schema.org/unitText"
            },
            "label": {
              "@id": "https://schema.org/name"
            }
          }
        },
        "tolerance": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#tolerance",
          "@context": {
            "percent": {
              "@id": "https://schema.org/value"
            },
            "code": {
              "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#code"
            }
          }
        },
        "condition": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#condition"
        },
        "quantity": {
          "@id": "https://schema.org/inventoryLevel"
        },
        "price": {
          "@id": "https://schema.org/price"
        },
        "currency": {
          "@id": "https://schema.org/priceCurrency"
        },
        "url": {
          "@id": "https://schema.org/url",
          "@type": "@id"
        },
        "ebay_listing": {
          "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#ebay_listing",
          "@type": "@id"
        }
      }
    }
  }
}
