    {
      "@id": "https://schema.org/currency",
      "@type": "rdf:Property",
      "rdfs:label": "currency",
      "rdfs:comment": "Currency of the shipping charge."
    },
    {
      "@id": "https://schema.org/description",
      "@type": "rdf:Property",
      "rdfs:label": "summary",
      "rdfs:comment": "The shipping terms as one sentence."
    },
    {
      "@id": "https://schema.org/eligibleRegion",
      "@type": "rdf:Property",
      "rdfs:label": "region_note",
      "rdfs:comment": "Where 33audio sells, quoted from the listing."
    },
    {
      "@id": "https://schema.org/email",
      "@type": "rdf:Property",
      "rdfs:label": "email",
      "rdfs:comment": "Contact and order email."
    },
    {
      "@id": "https://schema.org/inventoryLevel",
