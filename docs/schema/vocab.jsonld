    {
      "@id": "https://schema.org/model",
      "@type": "rdf:Property",
      "rdfs:label": [
        "name",
        "series"
      ],
      "rdfs:comment": [
        "Caddock model number.",
        "The Caddock model this part belongs to."
      ]
    },
    {
      "@id": "https://schema.org/mpn",
      "@type": "rdf:Property",
      "rdfs:label": "part_number",
      "rdfs:comment": "33audio part id: series, resistance, and a tolerance letter only when\n         the listing marks one, such as MM177-4.32K or MM177-665K-F."
    },
    {
      "@id": "https://schema.org/name",
      "@type": "rdf:Property",
      "rdfs:label": [
        "name",
        "label"
      ],
      "rdfs:comment": [
        "Business name.",
        "Human-readable value, such as 4.32 kΩ."
      ]
    },
    {
      "@id": "https://schema.org/price",
      "@type": "rdf:Property",
      "rdfs:label": [
        "unit_price",
        "price"
      ],
      "rdfs:comment": [
        "Listing price per resistor, the same for every part.",
        "Price per piece."
      ]
    },
    {
      "@id": "https://schema.org/priceCurrency",
      "@type": "rdf:Property",
      "rdfs:label": "currency",
      "rdfs:comment": [
        "Currency of every price in this document.",
        "Currency of price."
      ]
    },
    {
      "@id": "https://schema.org/sameAs",
      "@type": "rdf:Property",
      "rdfs:label": "ebay_store",
      "rdfs:comment": "33audio's eBay store front."
    },
    {
