      "rdfs:label": "family",
      "rdfs:comment": "Caddock resistor type."
    },
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#film",
      "@type": "rdf:Property",
      "rdfs:label": "film",
      "rdfs:comment": "Resistance film named on the Caddock datasheets."
    },
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#not_recommended_for_new_designs",
      "@type": "rdf:Property",
      "rdfs:label": "not_recommended_for_new_designs",
      "rdfs:comment": "True when Caddock marks the type Not Recommended for New Designs.\n         Caddock says this of Type MM."
    },
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#per",
      "@type": "rdf:Property",
      "rdfs:label": "per",
      "rdfs:comment": "What the shipping charge covers."
    },
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#power_rating",
      "@type": "rdf:Property",
      "rdfs:label": "power_rating",
      "rdfs:comment": "Rated power in watts at +25 C from the Caddock datasheet. MS models are\n         rated the same at +125 C.",
      "schema:unitCode": "WTT",
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q25236"
        }
      ]
    },
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#provenance",
      "@type": "rdf:Property",
      "rdfs:label": "provenance",
      "rdfs:comment": "Where the stock came from, quoted from the listing."
    },
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#series",
      "@type": "rdf:Property",
      "rdfs:label": "series",
      "rdfs:comment": "Caddock models in the catalog, with ratings from Caddock datasheets.",
      "rdfs:range": {
        "@id": "https://schema.org/ProductModel"
      }
    },
