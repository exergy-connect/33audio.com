  "@graph": [
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#code",
      "@type": "rdf:Property",
      "rdfs:label": "code",
      "rdfs:comment": "Tolerance letter."
    },
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#condition",
      "@type": "rdf:Property",
      "rdfs:label": "condition",
      "rdfs:comment": "Item condition. schema.org has no NOS value, so this links to Wikidata instead.",
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q907054"
        }
      ]
    },
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#default_tolerance",
      "@type": "rdf:Property",
      "rdfs:label": "default_tolerance",
      "rdfs:comment": "Tolerance of a part in this series unless its part number adds a letter."
    },
    {
      "@id": "https://exergy-connect.github.io/33audio.com/schema/vocab#ebay_listing",
      "@type": "rdf:Property",
      "rdfs:label": "ebay_listing",
      "rdfs:comment": "An active eBay listing for this exact part, when one is matched.",
