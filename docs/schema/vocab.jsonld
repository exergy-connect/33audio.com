      "rdfs:comment": "Quantity on the 33audio listing."
    },
    {
      "@id": "https://schema.org/isBasedOn",
      "@type": "rdf:Property",
      "rdfs:label": "source_url",
      "rdfs:comment": "The 33audio page this catalog was parsed from."
    },
    {
      "@id": "https://schema.org/itemListElement",
      "@type": "rdf:Property",
      "rdfs:label": "parts",
