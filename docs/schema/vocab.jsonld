        "@id": "https://schema.org/OfferShippingDetails"
      }
    },
    {
      "@id": "https://schema.org/shippingRate",
      "@type": "rdf:Property",
      "rdfs:label": "amount",
      "rdfs:comment": "Shipping charge per order."
    },
    {
      "@id": "https://schema.org/subjectOf",
      "@type": "rdf:Property",
      "rdfs:label": "datasheet",
      "rdfs:comment": "Link to the datasheet these ratings come from."
    },
    {
      "@id": "https://schema.org/unitText",
      "@type": "rdf:Property",
      "rdfs:label": "unit",
      "rdfs:comment": "Unit of value. Always ohm.",
      "schema:unitCode": "OHM",
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q47083"
        }
      ]
    },
    {
      "@id": "https://schema.org/url",
      "@type": "rdf:Property",
      "rdfs:label": "url",
      "rdfs:comment": "The part's page on the 33audio catalog site."
    },
    {
      "@id": "https://schema.org/value",
      "@type": "rdf:Property",
      "rdfs:label": [
        "value",
        "percent"
      ],
