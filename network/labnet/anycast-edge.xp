---
id: "33audio-anycast-edge"
title: "33audio: anycast path to the nearest edge"
summary: "A Houston visitor's ISP learns the shop's anycast prefix from two Cloudflare edge locations and forwards to the one with the shorter AS path."
eyebrow: "EXERGY ACADEMY · DELIVERY"
headline: "Anycast request path"

# Routing-level model of how a request for the 33audio shop reaches Cloudflare.
#
#   visitor -- isp_hou (AS 64510) ------------ cf_iah (AS 13335) -- web_iah 192.0.2.10
#                  \
#                   transit (AS 64520) ------ cf_dfw (AS 13335) -- web_dfw 192.0.2.10
#
# Both edge routers originate 192.0.2.0/24, a documentation prefix standing in for
# Cloudflare's anycast ranges. Both edge hosts answer on 192.0.2.10. The ISP prefers
# the direct peering with IAH (AS path 13335) over transit (64520 13335).
# anycast-edge-failover.xp is the same lab with the IAH peering removed.

topology:
  device: frr
  module: [bgp]
  name: 33audio-anycast-edge

  nodes:
    visitor:
      device: linux
      role: host
    isp_hou:
      device: frr
      bgp:
        as: 64510
    transit:
      device: frr
      bgp:
        as: 64520
    cf_iah:
      device: frr
      bgp:
        as: 13335
        advertise:
          - ipv4: 192.0.2.0/24
    cf_dfw:
      device: frr
      bgp:
        as: 13335
        advertise:
          - ipv4: 192.0.2.0/24
    web_iah:
      device: linux
      role: host
    web_dfw:
      device: linux
      role: host

  links:
    - visitor-isp_hou
    - isp_hou-cf_iah
    - isp_hou-transit
    - transit-cf_dfw
    - interfaces:
        - node: cf_iah
          ifname: eth9
          ipv4: 192.0.2.1/24
        - node: web_iah
          ifname: eth1
          ipv4: 192.0.2.10/24
    - interfaces:
        - node: cf_dfw
          ifname: eth9
          ipv4: 192.0.2.1/24
        - node: web_dfw
          ifname: eth1
          ipv4: 192.0.2.10/24

  validate:
    - label: ISP sessions to the IAH edge and to transit are up
      state:
        - node: isp_hou
          bgp:
            - peer: cf_iah
              asn: cf_iah.asn
              state: established
            - peer: transit
              asn: transit.asn
              state: established
    - label: ISP prefers the direct IAH peering for the anycast prefix
      state:
        - node: isp_hou
          routes:
            - prefix: 192.0.2.0/24
              protocol: bgp
              nexthop: cf_iah.ipv4.isp_hou
              aspath: "13335"
    - label: Visitor reaches the anycast address at IAH
      packet:
        from: visitor
        type: icmp-echo
        target: 192.0.2.10
        expect:
          type: icmp-echo-reply
          from: web_iah
