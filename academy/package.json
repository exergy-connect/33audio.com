{
  "name": "exergy-academy",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "cd .. && python -m academy build",
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:shop": "node tools/dev-shop.mjs",
    "deploy": "npm run build && wrangler deploy --var DEPLOYMENT:production",
    "lab-check": "node tools/lab-check.mjs",
    "measure": "node tools/measure.mjs",
    "test": "node --test ../tests/js/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  }
}
